# ==============================================================================
# Household Waste Sorting Advisor - Configuration Template
# ==============================================================================

# Server Environment
ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (MongoDB)
# If local MongoDB is running: mongodb://localhost:27017
# If using MongoDB Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net
# Note: If MongoDB is unavailable, system automatically falls back to local JSON storage!
MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=waste_advisor_db

# Storage Directories
UPLOAD_DIR=backend/uploads
MODEL_DIR=ml/saved_models
DATA_DIR=data

# AI Model Inference Settings
CONFIDENCE_THRESHOLD=0.70
MODEL_VERSION=mobilenetv2-waste-v1.0
USE_FALLBACK_IF_NO_WEIGHTS=true

# Big Data & Analytics Settings
SPARK_MASTER=local[*]
BATCH_PROCESSING_ENGINE=auto  # Options: auto, pyspark, pandas
ENABLE_SPARK_FALLBACK=true
