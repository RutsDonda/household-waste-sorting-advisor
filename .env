# ==============================================================================
# Household Waste Sorting Advisor - Local Environment Settings
# ==============================================================================

ENVIRONMENT=development
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=waste_advisor_db

UPLOAD_DIR=backend/uploads
MODEL_DIR=ml/saved_models
DATA_DIR=data

CONFIDENCE_THRESHOLD=0.70
MODEL_VERSION=mobilenetv2-waste-v1.0
USE_FALLBACK_IF_NO_WEIGHTS=true

SPARK_MASTER=local[*]
BATCH_PROCESSING_ENGINE=auto
ENABLE_SPARK_FALLBACK=true
